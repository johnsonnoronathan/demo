---
import Base from "../layouts/Base.astro";
import CourseCard from "../components/CourseCard.astro";
import { courseEntries } from "../lib/course";
import type { Locale } from "../i18n/locales";
import { t } from "../i18n/ui";
interface Props {
  locale: Locale;
}
const { locale: L } = Astro.props;
const entries = await courseEntries();
---

<Base title={`${t(L, "catalog.title")} · Testbench`} description={t(L, "catalog.sub")} locale={L} path="/courses/" section="courses">
  <main id="main" class="catalog wrap">
    <header class="page-head">
      <h1>{t(L, "catalog.title")}</h1>
      <p class="sec-sub">{t(L, "catalog.sub")}</p>
    </header>
    <div class="course-grid course-grid-detailed">
      {entries.map((c, i) => <CourseCard courseId={c.id} locale={L} index={i} detailed />)}
    </div>
  </main>
</Base>
