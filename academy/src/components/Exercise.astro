---
import AgentPrompt from "./AgentPrompt.astro";
import { buildPrompt } from "../lib/prompt";
import { inline } from "../lib/inline";
import { t } from "../i18n/ui";

interface Props {
  id: string;
}
const view = Astro.locals.lesson;
if (!view) throw new Error("<Exercise> must be rendered inside a lesson page");
const L = view.locale;
const ex = view.entry.data.exercises.find((e) => e.id === Astro.props.id) ?? view.en.data.exercises.find((e) => e.id === Astro.props.id);
if (!ex) throw new Error(`Exercise "${Astro.props.id}" is not in the frontmatter of ${view.sourcePath}`);
const prompt = buildPrompt(view, ex.id);
const key = `${view.path}#${ex.id}`;
---

<section class="exercise" id={`ex-${ex.id}`}>
  <header class="ex-head">
    <span class="ex-kicker">{t(L, "ex.kicker", { n: ex.minutes })}</span>
    <p class="ex-goal"><b>{t(L, "ex.goal")}</b> <Fragment set:html={inline(ex.goal)} /></p>
  </header>
  <div class="ex-body">
    <p class="ex-part">{t(L, "ex.yours")}</p>
    <slot />
  </div>
  <div class="ex-done-when">
    <b>{t(L, "ex.doneWhen")}</b>
    <ul>{ex.agent.done.map((d) => <li set:html={inline(d)} />)}</ul>
  </div>
  <AgentPrompt prompt={prompt} title={ex.title} />
  <label class="ex-check">
    <input type="checkbox" data-progress-exercise={key} />
    <span>{t(L, "ex.check")}</span>
  </label>
</section>
