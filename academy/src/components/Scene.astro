---
import { scenes } from "../scenes";

interface Props {
  name: string;
}
const { name } = Astro.props;
const def = scenes[name];
if (!def) throw new Error(`Unknown scene "${name}"`);
const height = def.height ?? 360;
---

<tb-scene class="scene" data-scene={name}>
  <figure>
    <div class="scene-head">
      <span class="scene-kicker">Concept animation</span>
      <figcaption>{def.title}</figcaption>
    </div>
    <div class="scene-stage">
      <svg viewBox={`0 0 720 ${height}`} role="img" aria-label={`${def.title}. ${def.steps.join(" ")}`}></svg>
    </div>
    <div class="scene-controls">
      <button class="scene-play" type="button" aria-label="Play animation">
        <svg class="i-play" viewBox="0 0 20 20" aria-hidden="true"><path d="M6 4l10 6-10 6z" fill="currentColor"></path></svg>
        <svg class="i-pause" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 4h3.5v12H5zM11.5 4H15v12h-3.5z" fill="currentColor"></path></svg>
        <svg class="i-replay" viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4a6 6 0 1 1-5.7 4.1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path><path d="M3 3.5v5h5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
      <ol class="scene-steps">
        {def.steps.map((_, i) => (
          <li><button type="button" data-step={i} aria-label={`Go to step ${i + 1} of ${def.steps.length}`}><i></i></button></li>
        ))}
      </ol>
      <span class="scene-count">1 / {def.steps.length}</span>
    </div>
    <ol class="scene-captions">
      {def.steps.map((s, i) => <li data-caption={i}>{s}</li>)}
    </ol>
  </figure>
</tb-scene>

<script>
  import "../scripts/scene-player";
</script>
