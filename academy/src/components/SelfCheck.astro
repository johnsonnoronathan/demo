---
import { inline } from "../lib/inline";
/** Self-check questions from the frontmatter, with answers behind a disclosure. */
const view = Astro.locals.lesson!;
---

<ol class="self-check">
  {
    view.entry.data.check.map((c) => (
      <li>
        <p class="sc-q" set:html={inline(c.q)} />
        <details>
          <summary>Show answer</summary>
          <p set:html={inline(c.a)} />
        </details>
      </li>
    ))
  }
</ol>
