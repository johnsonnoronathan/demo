---
/** "What you'll get": the outcomes in the current page's frontmatter. */
import { inline } from "../lib/inline";
import { t } from "../i18n/ui";
interface Props {
  title?: string;
}
const view = Astro.locals.lesson!;
const title = Astro.props.title ?? t(view.locale, "course.opening");
---

<section class="outcomes">
  <h2 class="outcomes-title">{title}</h2>
  <ul>{view.entry.data.outcomes.map((o) => <li set:html={inline(o)} />)}</ul>
</section>
