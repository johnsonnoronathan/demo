---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import CourseArc from "../../components/CourseArc.astro";
import { loadCourse, chapterLessons, totalMinutes, formatMinutes, type LessonView } from "../../lib/course";

export async function getStaticPaths() {
  const courses = await getCollection("courses");
  return courses.map((c) => ({ params: { course: c.id } }));
}

const { course, lessons } = await loadCourse(Astro.params.course!);
const d = course.data;
const exercises = lessons.reduce((a, l) => a + l.entry.data.exercises.length, 0);
const scenes = lessons.reduce((a, l) => a + l.entry.data.concepts.filter((c) => c.scene).length, 0);
const minor = lessons.filter((l) => l.entry.data.kind === "lesson").length;
const paths = lessons.map((l) => l.path).join(" ");
const kindLabel = (l: LessonView) =>
  l.entry.data.kind === "opening" ? "What you'll get" : l.entry.data.kind === "summary" ? "Chapter summary" : l.entry.data.title;
---

<Base title={`${d.title} · Testbench`} description={d.summary} course={{ id: course.id, title: d.title }} mode="classroom" markdown={`/${course.id}.md`}>
  <main class="course-home">
    <section class="ch-hero wrap">
      <div class="ch-hero-copy">
        <p class="eyebrow">Classroom · {formatMinutes(totalMinutes(lessons))} · {minor} lessons · {exercises} hands-on exercises</p>
        <h1>{d.title}</h1>
        <p class="ch-tagline">{d.tagline}</p>
        <p class="ch-summary">{d.summary}</p>
        <div class="ch-cta">
          <a class="btn btn-primary btn-lg" href={lessons[0].url} data-continue={paths} data-continue-label="Continue where you left off">Start the course</a>
          <a class="btn btn-lg" href={`/${course.id}/plan/`}>Read the lesson plan</a>
        </div>
      </div>
      <dl class="ch-facts">
        <div><dt>Concept animations</dt><dd>{scenes}</dd></div>
        <div><dt>Hands-on exercises</dt><dd>{exercises}</dd></div>
        <div><dt>Agent prompts</dt><dd>{exercises}</dd></div>
        <div><dt>Practice app</dt><dd class="ch-facts-app">{d.practice.name}</dd></div>
      </dl>
    </section>

    <section class="wrap">
      <h2 class="sec-h">How the course is built</h2>
      <p class="sec-sub">Overall, then specific, then overall again. Every chapter opens with what you'll get and closes with a summary.</p>
      <CourseArc course={course} />
    </section>

    <section class="wrap chapters">
      {
        d.chapters.map((c, i) => {
          const ls = chapterLessons(lessons, c.id);
          return (
            <article class="chapter-card">
              <header>
                <span class="cc-n">Chapter {i + 1}</span>
                <h2><a href={`/${course.id}/${c.id}/`}>{c.title}</a></h2>
                <p>{c.summary}</p>
                <div class="meter" data-chapter-progress={ls.map((l) => l.path).join(" ")}>
                  <i></i>
                  <span class="cp-label">0 of {ls.length} done</span>
                  <span>{formatMinutes(totalMinutes(ls))}</span>
                </div>
              </header>
              <ol class="cc-list">
                {ls.map((l) => (
                  <li>
                    <a href={l.url} data-progress-link={l.path} class={`cc-${l.entry.data.kind}`}>
                      <span class="cc-num">{l.entry.data.kind === "lesson" ? l.number : l.entry.data.kind === "opening" ? "▸" : "Σ"}</span>
                      <span class="cc-title">{kindLabel(l)}</span>
                      <span class="cc-tags">
                        {l.entry.data.concepts.some((x) => x.scene) && <span class="tag tag-scene">animation</span>}
                        {l.entry.data.exercises.length > 0 && <span class="tag tag-ex">hands-on</span>}
                      </span>
                      <span class="cc-min">{l.entry.data.minutes} min</span>
                    </a>
                  </li>
                ))}
              </ol>
            </article>
          );
        })
      }
    </section>

    <section class="wrap two-col">
      <div>
        <h2 class="sec-h">You'll be able to</h2>
        <ul class="check-list">{d.outcomes.map((o) => <li>{o}</li>)}</ul>
      </div>
      <div>
        <h2 class="sec-h">Before you start</h2>
        <p class="sec-sub">{d.audience}</p>
        <ul class="plain-list">{d.prerequisites.map((p) => <li>{p}</li>)}</ul>
        <h3 class="mini-h">Set up the practice app</h3>
        <pre class="setup"><code>{d.practice.setup.join("\n")}</code></pre>
      </div>
    </section>
  </main>
</Base>
