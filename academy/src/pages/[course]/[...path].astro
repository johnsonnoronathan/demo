---
import { inline } from "../../lib/inline";
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import CourseNav from "../../components/CourseNav.astro";
import Scene from "../../components/Scene.astro";
import Screenshot from "../../components/Screenshot.astro";
import Exercise from "../../components/Exercise.astro";
import Callout from "../../components/Callout.astro";
import Outcomes from "../../components/Outcomes.astro";
import ChapterMap from "../../components/ChapterMap.astro";
import ChapterRecap from "../../components/ChapterRecap.astro";
import SelfCheck from "../../components/SelfCheck.astro";
import CourseArc from "../../components/CourseArc.astro";
import { loadCourse, neighbours, type LessonView } from "../../lib/course";

export async function getStaticPaths() {
  const courses = await getCollection("courses");
  const paths = [];
  for (const c of courses) {
    const { lessons } = await loadCourse(c.id);
    for (const view of lessons) {
      paths.push({ params: { course: c.id, path: view.path.slice(c.id.length + 1) }, props: { view, lessons } });
    }
  }
  return paths;
}

interface Props {
  view: LessonView;
  lessons: LessonView[];
}
const { view, lessons } = Astro.props;
Astro.locals.lesson = view;
const d = view.entry.data;
const { Content, headings } = await render(view.entry);
const { prev, next } = neighbours(lessons, view);
const toc = headings.filter((h) => h.depth === 2);
const components = { Scene, Screenshot, Exercise, Callout, Outcomes, ChapterMap, ChapterRecap, SelfCheck, CourseArc };
const kicker =
  d.kind === "lesson"
    ? `Lesson ${view.number}`
    : `Chapter ${view.chapterNumber} · ${d.kind === "opening" ? "Opening" : "Summary"}`;
---

<Base
  title={`${d.kind === "lesson" ? `${view.number} ${d.title}` : d.title} · ${view.course.data.title}`}
  description={d.description}
  course={{ id: view.course.id, title: view.course.data.title }}
  mode="classroom"
  markdown={view.mdUrl}
>
  <div class="classroom">
    <details class="nav-drawer">
      <summary>Course contents</summary>
      <CourseNav lessons={lessons} current={view} />
    </details>
    <aside class="cr-nav">
      <CourseNav lessons={lessons} current={view} />
    </aside>

    <main class={`cr-main kind-${d.kind}`} id="main">
      <p class="crumbs">
        <a href={`/${view.course.id}/`}>{view.course.data.title}</a>
        <span aria-hidden="true">/</span>
        <a href={`/${view.course.id}/${view.chapter.id}/`}>Chapter {view.chapterNumber} · {view.chapter.title}</a>
      </p>
      <header class="lesson-head">
        <p class="lesson-kicker">
          <span>{kicker}</span>
          <span>{d.minutes} min</span>
          {d.concepts.length > 0 && <span>{d.concepts.length} {d.concepts.length === 1 ? "concept" : "concepts"}</span>}
          {d.exercises.length > 0 && <span class="has-ex">{d.exercises.length} hands-on</span>}
        </p>
        <h1>{d.title}</h1>
        <p class="lede">{d.description}</p>
      </header>

      {
        d.kind === "lesson" && d.outcomes.length > 0 && (
          <section class="you-will">
            <h2 class="yw-title">You'll be able to</h2>
            <ul>{d.outcomes.map((o) => <li set:html={inline(o)} />)}</ul>
          </section>
        )
      }

      <article class="prose">
        <Content components={components} />
      </article>

      {
        d.kind === "lesson" && d.keyPoints.length > 0 && (
          <section class="key-points" id="key-points">
            <h2>Key points</h2>
            <ul>{d.keyPoints.map((k) => <li set:html={inline(k)} />)}</ul>
          </section>
        )
      }

      <div class="complete-row">
        <button type="button" class="btn" data-complete={view.path}>Mark this page complete</button>
      </div>

      <nav class="pager" aria-label="Previous and next">
        {prev ? (
          <a href={prev.url} class="pg-prev"><small>Previous · {prev.label}</small>{prev.entry.data.title}</a>
        ) : <span></span>}
        {next ? (
          <a href={next.url} class="pg-next"><small>Next · {next.label}</small>{next.entry.data.title}</a>
        ) : (
          <a href={`/${view.course.id}/plan/`} class="pg-next"><small>Finished</small>See the lesson plan</a>
        )}
      </nav>
    </main>

    <aside class="cr-toc">
      {
        toc.length > 0 && (
          <nav aria-label="On this page">
            <p class="toc-h">On this page</p>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )
      }
      <div class="toc-agent">
        <p class="toc-h">For agents</p>
        <a href={view.mdUrl}>This page as Markdown</a>
        <span>Source: <code>{view.sourcePath.replace("academy/src/content/lessons/", "…/")}</code></span>
      </div>
    </aside>
  </div>
  <script is:inline define:vars={{ path: view.path }}>document.body.dataset.lesson = path;</script>
</Base>
