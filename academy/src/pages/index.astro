---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { loadCourse, totalMinutes, formatMinutes } from "../lib/course";

const courses = await Promise.all((await getCollection("courses")).map((c) => loadCourse(c.id)));
---

<Base title="Testbench" description="Testing tutorials written for people and for agents.">
  <main class="catalog wrap">
    <section class="cat-hero">
      <p class="eyebrow">Testbench</p>
      <h1>Testing tutorials for people and their agents.</h1>
      <p class="cat-sub">
        Each course teaches with animated concepts and hands-on exercises on a real practice app. Exercises come with a
        prompt you can hand to a coding agent, and every page has a Markdown twin that agents can read directly.
      </p>
    </section>
    <ul class="cat-list">
      {
        courses.map(({ course, lessons }) => (
          <li>
            <a class="cat-card" href={`/${course.id}/`}>
              <span class="cat-meta">{formatMinutes(totalMinutes(lessons))} · {course.data.chapters.length} chapters · {lessons.filter((l) => l.entry.data.kind === "lesson").length} lessons</span>
              <b>{course.data.title}</b>
              <span>{course.data.tagline}</span>
              <span class="cat-chapters">{course.data.chapters.map((c) => c.title).join(" → ")}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <section class="cat-how">
      <div>
        <h2>Classroom</h2>
        <p>Learn in order. Concepts play as short animations; hands-on exercises walk you through the practice app with screenshots.</p>
      </div>
      <div>
        <h2>Lesson plan</h2>
        <p>The same course as a plan: goals, timings, key points and exercises for every chapter, on one page.</p>
      </div>
      <div>
        <h2>For agents</h2>
        <p>Copy an exercise's prompt into a coding agent, or point it at <a href="/llms.txt">llms.txt</a> to read the whole course as Markdown.</p>
      </div>
    </section>
  </main>
</Base>
